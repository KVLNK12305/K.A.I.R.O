<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUOTE PRISM • WISDOM"
            android:textColor="#8888A0"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_quote_reference"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CH 2:47"
            android:textColor="#FFD700"
            android:textSize="10sp"
            android:textStyle="bold"
            android:typeface="monospace" />
    </LinearLayout>

    <!-- Sanskrit Text -->
    <TextView
        android:id="@+id/tv_quote_slok"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="end"
        android:text="कर्मण्येवाधिकारस्ते मा फलेषु कदाचन।"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Divider line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#2A2A38" />

    <!-- English Translation -->
    <TextView
        android:id="@+id/tv_quote_translation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="You have a right to perform your prescribed duties, but you are not entitled to the fruits of your actions."
        android:textColor="#AAAAAA"
        android:textSize="10sp"
        android:textStyle="italic" />

</LinearLayout>
