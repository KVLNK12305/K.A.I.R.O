<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="ENERGY ARC"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_energy_avg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="0%"
            android:textColor="@color/vibrant_orange"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Peak 1 Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="PEAK 1"
            android:textColor="@color/vibrant_orange"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pb_peak1"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_progress_track"
            android:progressDrawable="@drawable/widget_fill_orange"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/tv_peak1_pct"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:fontFamily="sans-serif-medium"
            android:text="0%"
            android:textColor="@color/widget_text_primary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Peak 2 Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="PEAK 2"
            android:textColor="@color/vibrant_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pb_peak2"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_progress_track"
            android:progressDrawable="@drawable/widget_fill_cyan"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/tv_peak2_pct"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:fontFamily="sans-serif-medium"
            android:text="0%"
            android:textColor="@color/widget_text_primary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Recovery Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="RECOVER"
            android:textColor="@color/vibrant_purple"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pb_recovery"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_progress_track"
            android:progressDrawable="@drawable/widget_fill_purple"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/tv_recovery_pct"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:fontFamily="sans-serif-medium"
            android:text="0%"
            android:textColor="@color/widget_text_primary"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
